# Copy this file to .env, then set the Matrix account allowed to publish exams.
DB_DRIVER=sqlite
SQLITE_PATH=data/exams.sqlite
MATRIX_URL=https://matrix-client.matrix.org
EXAM_ADMIN_IDS=
HOST=127.0.0.1
PORT=3491
AI_PROVIDER=disabled
# AI_PROVIDER=ollama or gemini; set AI_MODEL to an installed/supported model.
# AI_MODEL=your-model-name
# OLLAMA_URL=http://127.0.0.1:11434
# GEMINI_API_KEY=your-key

# For PostgreSQL use DB_DRIVER=postgres and set DATABASE_URL, or set all of
# PGHOST, PGUSER, PGDATABASE and PGPASSWORD (PGPORT is optional).
# DATABASE_URL=postgresql://user:password@localhost:5432/heapexam
